# Server-Side Configuration (Vercel Serverless / Backend)
# Neon PostgreSQL Connection String (Never prefix with VITE_)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/neondb?sslmode=require

# JWT Session Signing Secret (Random 32+ character string)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=super_secret_session_jwt_key_here

# Optional Client Integrations
VITE_GOOGLE_CLIENT_ID=
